# Copy this file to .env and fill in any required credentials.

# Local Ollama: leave OLLAMA_API_KEY empty.
# Ollama Cloud: use OLLAMA_HOST=https://ollama.com and add your API key.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Retrieval configuration
RAG_RETRIEVAL_MODE=hybrid
RAG_FUSION_METHOD=rrf
RAG_FUSION_ALPHA=0.65
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=6
RAG_RRF_K=60
RAG_SEMANTIC_POOL_FACTOR=3
RAG_USE_FAISS=true

# API server configuration
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uncomment these when using OpenAI embeddings.
# OPENAI_API_KEY=
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small
